# 本地环境配置文件
# 复制此文件为 .env.local 并修改为你的实际配置
# .env.local 不会被提交到 Git

# MacCMS API 配置
VITE_MACCMS_API_URL=http://localhost:8080/api.php/provide/vod
VITE_MACCMS_TIMEOUT=10000

# 应用配置
VITE_APP_PACKAGE_NAME=es.tv.huan.hellotv
VITE_APP_VERSION=1.0.0

# 调试配置
VITE_USE_MOCK_DATA=true
VITE_DEBUG_MODE=true
VITE_TV_BOX_SIMPLE_MODE=true

# 开发服务器配置
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=38989
