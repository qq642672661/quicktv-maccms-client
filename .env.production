# 环境配置
NODE_ENV=production

# MacCMS API 配置
VITE_MACCMS_API_URL=http://your-production-maccms-api.com/api.php/provide/vod
VITE_MACCMS_TIMEOUT=10000

# 应用配置
VITE_APP_PACKAGE_NAME=es.tv.huan.hellotv
VITE_APP_VERSION=1.0.0

# 调试配置
VITE_USE_MOCK_DATA=false
VITE_DEBUG_MODE=false

# 开发服务器配置
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=38989
