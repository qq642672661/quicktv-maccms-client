<!--
  首页组件 - 视频列表展示页面
  功能：
  1. 展示视频分类导航
  2. 视频列表网格展示
  3. 搜索功能
  4. 分页功能
  5. 底部导航栏（首页/直播/管理）
-->
<template>
  <!-- 首页主容器 -->
  <div class="home-page">
    <!-- 顶部区域：包含标题、搜索栏和分类导航 -->
    <div class="header">
      <!-- 应用标题 -->
      <text class="title">MacCMS影视</text>

      <!-- 搜索栏区域 -->
      <div class="search-bar">
        <!-- 搜索输入框：绑定searchKeyword数据，支持焦点导航 -->
        <input
          type="text"
          class="search-input"
          placeholder="搜索影视剧..."
          value="{{searchKeyword}}"
          onchange="handleSearchInput"
          focusable="true"
        />
        <!-- 搜索按钮：点击触发搜索 -->
        <text class="search-btn" onclick="handleSearch" focusable="true">搜索</text>
      </div>

      <!-- 分类导航菜单 -->
      <div class="nav-menu">
        <!-- "全部"分类按钮：显示所有视频 -->
        <text
          class="nav-item {{currentTypeId === null ? 'active' : ''}}"
          onclick="handleTypeChange(null)"
          focusable="true"
        >全部</text>
        <!-- 循环渲染各个分类按钮 -->
        <block for="{{types}}">
          <text
            class="nav-item {{currentTypeId === $item.id ? 'active' : ''}}"
            onclick="handleTypeChange($item.id)"
            focusable="true"
          >{{$item.name}}</text>
        </block>
      </div>
    </div>

    <!-- 内容区域：视频列表、加载状态、空状态、分页 -->
    <div class="content">
      <!-- 视频网格：当不在加载中且有视频数据时显示 -->
      <div class="video-grid" if="{{!loading && videos.length > 0}}">
        <!-- 循环渲染每个视频卡片 -->
        <block for="{{videos}}">
          <div
            class="video-card"
            onclick="handleVideoClick($item.id)"
            focusable="true"
          >
            <!-- 视频封面图 -->
            <image class="video-poster" src="{{$item.vod_pic}}" />
            <!-- 视频信息：标题和备注 -->
            <div class="video-info">
              <text class="video-name">{{$item.vod_name}}</text>
              <text class="video-remarks">{{$item.vod_remarks}}</text>
            </div>
          </div>
        </block>
      </div>

      <!-- 加载状态：数据加载中时显示 -->
      <div class="loading" if="{{loading}}">
        <text>加载中...</text>
      </div>

      <!-- 空状态：没有数据时显示 -->
      <div class="empty" if="{{!loading && videos.length === 0}}">
        <text>暂无视频</text>
      </div>

      <!-- 分页控件：当总页数大于1时显示 -->
      <div class="pagination" if="{{!loading && totalPages > 1}}">
        <!-- 上一页按钮：第一页时禁用 -->
        <text
          class="page-btn {{currentPage === 1 ? 'disabled' : ''}}"
          onclick="handlePrevPage"
          focusable="true"
        >上一页</text>
        <!-- 页码信息：当前页/总页数 -->
        <text class="page-info">{{currentPage}} / {{totalPages}}</text>
        <!-- 下一页按钮：最后一页时禁用 -->
        <text
          class="page-btn {{currentPage === totalPages ? 'disabled' : ''}}"
          onclick="handleNextPage"
          focusable="true"
        >下一页</text>
      </div>
    </div>

    <!-- 底部导航栏：首页、直播、管理三个标签 -->
    <div class="footer">
      <!-- 首页标签：当前激活时高亮显示 -->
      <text
        class="footer-btn {{activeTab === 'home' ? 'active' : ''}}"
        onclick="handleTabChange('home')"
        focusable="true"
      >首页</text>
      <!-- 直播标签 -->
      <text
        class="footer-btn {{activeTab === 'live' ? 'active' : ''}}"
        onclick="handleTabChange('live')"
        focusable="true"
      >直播</text>
      <!-- 管理标签 -->
      <text
        class="footer-btn {{activeTab === 'admin' ? 'active' : ''}}"
        onclick="handleTabChange('admin')"
        focusable="true"
      >管理</text>
    </div>
  </div>
</template>

<style>
.home-page {
  flex-direction: column;
  width: 1920px;
  height: 1080px;
  background-color: #000000;
}

.header {
  flex-direction: column;
  padding: 30px 60px;
  background-color: #1a1a1a;
}

.title {
  font-size: 48px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 20px;
}

.search-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
}

.search-input {
  flex: 1;
  height: 60px;
  padding: 0 20px;
  font-size: 28px;
  color: #ffffff;
  background-color: #2a2a2a;
  border-radius: 8px;
  border-width: 2px;
  border-color: #3a3a3a;
}

.search-input:focus {
  border-color: #ff6b6b;
}

.search-btn {
  width: 120px;
  height: 60px;
  margin-left: 20px;
  font-size: 28px;
  color: #ffffff;
  background-color: #ff6b6b;
  border-radius: 8px;
  text-align: center;
  lines: 1;
}

.search-btn:focus {
  background-color: #ff5252;
}

.nav-menu {
  flex-direction: row;
  flex-wrap: wrap;
}

.nav-item {
  padding: 15px 30px;
  margin-right: 20px;
  margin-bottom: 10px;
  font-size: 28px;
  color: #999999;
  background-color: #2a2a2a;
  border-radius: 8px;
}

.nav-item:focus {
  background-color: #3a3a3a;
  color: #ffffff;
}

.nav-item.active {
  color: #ffffff;
  background-color: #ff6b6b;
}

.content {
  flex: 1;
  flex-direction: column;
  padding: 30px 60px;
  overflow: hidden;
}

.video-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.video-card {
  width: 280px;
  margin-right: 30px;
  margin-bottom: 30px;
  border-radius: 8px;
  overflow: hidden;
  background-color: #1a1a1a;
}

.video-card:focus {
  border-width: 3px;
  border-color: #ff6b6b;
}

.video-poster {
  width: 280px;
  height: 400px;
  object-fit: cover;
}

.video-info {
  flex-direction: column;
  padding: 15px;
}

.video-name {
  font-size: 26px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
  margin-bottom: 8px;
}

.video-remarks {
  font-size: 22px;
  color: #999999;
}

.loading,
.empty {
  flex: 1;
  justify-content: center;
  align-items: center;
}

.loading text,
.empty text {
  font-size: 32px;
  color: #666666;
}

.pagination {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 20px 0;
}

.page-btn {
  padding: 15px 40px;
  font-size: 28px;
  color: #ffffff;
  background-color: #ff6b6b;
  border-radius: 8px;
  margin: 0 20px;
}

.page-btn:focus {
  background-color: #ff5252;
}

.page-btn.disabled {
  background-color: #3a3a3a;
  color: #666666;
}

.page-info {
  font-size: 28px;
  color: #ffffff;
}

.footer {
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  height: 100px;
  background-color: #1a1a1a;
  border-top-width: 1px;
  border-top-color: #2a2a2a;
}

.footer-btn {
  flex: 1;
  height: 100px;
  font-size: 28px;
  color: #999999;
  text-align: center;
  lines: 1;
}

.footer-btn:focus {
  background-color: #2a2a2a;
}

.footer-btn.active {
  color: #ff6b6b;
}
</style>

<!--
  脚本逻辑部分
  负责数据管理、API调用和用户交互处理
-->
<script>
// 导入API服务模块，用于与后端通信
import api from '../services/api.js'
// 导入路由模块，用于页面跳转
import router from '@system.router'

export default {
  // 数据定义：组件的响应式数据
  data: {
    searchKeyword: '',      // 搜索关键词
    types: [],              // 视频分类列表
    currentTypeId: null,    // 当前选中的分类ID（null表示全部）
    videos: [],             // 视频列表数据
    loading: false,         // 加载状态标识
    currentPage: 1,         // 当前页码
    totalPages: 1,          // 总页数
    activeTab: 'home'       // 当前激活的底部标签
  },

  /**
   * 生命周期：页面初始化
   * 在页面加载时自动调用，用于初始化数据
   */
  onInit() {
    this.loadTypes()    // 加载视频分类
    this.loadVideos()   // 加载视频列表
  },

  /**
   * 加载视频分类列表
   * 从后端API获取所有视频分类，用于顶部导航栏
   */
  async loadTypes() {
    try {
      // 调用API获取分类数据
      const response = await api.getVideoTypes()
      // 兼容不同的响应格式（data.categories 或 data）
      const items = response.data?.categories || response.data || []
      // 数据映射：统一字段名称
      this.types = items.map(type => ({
        id: type.id || type.category_id,           // 分类ID
        name: type.name || type.category_name      // 分类名称
      }))
    } catch (error) {
      console.error('加载分类失败:', error)
    }
  },

  /**
   * 加载视频列表
   * 根据当前页码、分类ID从后端获取视频数据
   * 支持分页和分类筛选
   */
  async loadVideos() {
    this.loading = true  // 开始加载，显示加载状态
    try {
      // 调用API获取视频列表：传入页码、每页数量、分类ID
      const response = await api.getVideos(this.currentPage, 20, this.currentTypeId)
      // 兼容不同的响应格式
      const items = response.data?.items || response.data || []
      // 数据映射：统一字段名称，兼容MacCMS和自定义格式
      this.videos = items.map(video => ({
        id: video.id || video.video_id,                                    // 视频ID
        vod_name: video.title || video.vod_name,                          // 视频标题
        vod_pic: video.cover_image || video.coverImage || video.vod_pic, // 封面图
        vod_remarks: video.resolution || video.vod_remarks || ''          // 备注（如清晰度）
      }))
      // 获取总页数
      this.totalPages = response.data?.totalPages || response.totalPages || 1
    } catch (error) {
      console.error('加载视频失败:', error)
      this.videos = []  // 加载失败时清空列表
    } finally {
      this.loading = false  // 结束加载状态
    }
  },

  /**
   * 处理搜索输入
   * 当用户在搜索框输入时触发
   * @param {Object} e - 事件对象，包含输入的值
   */
  handleSearchInput(e) {
    this.searchKeyword = e.value
  },

  /**
   * 执行搜索
   * 根据搜索关键词从后端搜索视频
   * 搜索后重置到第一页
   */
  async handleSearch() {
    // 如果搜索关键词为空，不执行搜索
    if (!this.searchKeyword.trim()) {
      return
    }

    this.loading = true  // 开始搜索
    try {
      // 调用搜索API：传入关键词、页码、每页数量
      const response = await api.searchVideos(this.searchKeyword, 1, 20)
      // 兼容不同的响应格式
      const items = response.data?.items || response.data || []
      // 数据映射：统一字段名称
      this.videos = items.map(video => ({
        id: video.id || video.video_id,
        vod_name: video.title || video.vod_name,
        vod_pic: video.cover_image || video.coverImage || video.vod_pic,
        vod_remarks: video.resolution || video.vod_remarks || ''
      }))
      // 更新分页信息
      this.totalPages = response.data?.totalPages || response.totalPages || 1
      this.currentPage = 1  // 搜索后重置到第一页
    } catch (error) {
      console.error('搜索失败:', error)
      this.videos = []  // 搜索失败时清空列表
    } finally {
      this.loading = false  // 结束加载状态
    }
  },

  /**
   * 处理分类切换
   * 当用户点击分类按钮时触发
   * @param {Number|null} typeId - 分类ID，null表示全部
   */
  handleTypeChange(typeId) {
    this.currentTypeId = typeId  // 更新当前分类
    this.currentPage = 1         // 重置到第一页
    this.loadVideos()            // 重新加载视频列表
  },

  /**
   * 处理视频点击
   * 跳转到视频详情页
   * @param {Number} videoId - 视频ID
   */
  handleVideoClick(videoId) {
    router.push({
      uri: 'pages/VideoDetail',  // 目标页面路径
      params: { id: videoId }    // 传递视频ID参数
    })
  },

  /**
   * 处理上一页
   * 当前页大于1时，页码减1并重新加载数据
   */
  handlePrevPage() {
    if (this.currentPage > 1) {
      this.currentPage--   // 页码减1
      this.loadVideos()    // 重新加载视频列表
    }
  },

  /**
   * 处理下一页
   * 当前页小于总页数时，页码加1并重新加载数据
   */
  handleNextPage() {
    if (this.currentPage < this.totalPages) {
      this.currentPage++   // 页码加1
      this.loadVideos()    // 重新加载视频列表
    }
  },

  /**
   * 处理底部标签切换
   * 根据选中的标签进行页面跳转
   * @param {String} tab - 标签名称（home/live/admin）
   */
  handleTabChange(tab) {
    this.activeTab = tab  // 更新激活标签
    if (tab === 'live') {
      // 跳转到直播页面
      router.push({ uri: 'pages/Live' })
    } else if (tab === 'admin') {
      // 跳转到管理页面
      router.push({ uri: 'pages/Admin' })
    }
    // home标签不需要跳转，因为已经在首页
  }
}
</script>
