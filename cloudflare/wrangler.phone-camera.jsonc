{
  "name": "quicktv-phone-camera",
  "main": "phone-camera-worker.mjs",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PHONE_CAMERA_ROOMS",
        "class_name": "QuickTvPhoneCameraRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuickTvPhoneCameraRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
